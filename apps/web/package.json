{
  "name": "@wordhold/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun build --target=bun --outdir=.output/maintenance scripts/repair-practice-reviews.ts",
    "start": "bun .output/server/index.mjs",
    "check-types": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "provider:verify": "bun scripts/verify-ai-provider.ts",
    "test": "bun test",
    "test:a11y": "playwright install chromium && playwright test",
    "practice:repair": "bun --env-file=.env.local scripts/repair-practice-reviews.ts",
    "practice:repair:production": "bun .output/maintenance/repair-practice-reviews.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@wordhold/ai": "workspace:*",
    "@wordhold/db": "workspace:*",
    "@wordhold/ui": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "effect": "^3.22.2",
    "image-dimensions": "^2.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
