{
  "name": "@wordhold/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./drizzle": "./src/drizzle.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/courses": "./src/schema/courses.ts",
    "./schema/pages": "./src/schema/pages.ts",
    "./schema/units": "./src/schema/units.ts",
    "./schema/entries": "./src/schema/entries.ts",
    "./schema/practice": "./src/schema/practice.ts",
    "./testing/postgres-test-database": "./src/testing/postgres-test-database.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local src/migrate.ts"
  },
  "dependencies": {
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@davidvornholt/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
